# Copy to .env (git ignores it) and fill in. Never commit the real file.
RUNPOD_API_KEY=
CKREMOTE_ENDPOINT_ID=
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
CKREMOTE_S3_ENDPOINT=
CKREMOTE_S3_BUCKET=
CKREMOTE_S3_KEY_ID=
CKREMOTE_S3_SECRET=
CKREMOTE_S3_REGION=auto
# Optional: your GPU's serverless price in USD per second, for cost estimates.
CKREMOTE_RATE_PER_SEC=
